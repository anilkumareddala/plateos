/* PlateOS v5: owner intelligence, exports, closeouts and phone companion */
.an-ask{padding:19px 21px;margin-bottom:18px;border:1px solid #cce9df;background:linear-gradient(120deg,#fff,#f8fdfa)}.an-ask-heading{display:flex;align-items:center;gap:12px}.an-ask-heading>div{flex:1}.an-ask-heading strong{font:800 14px 'Plus Jakarta Sans',sans-serif}.an-ask-heading p{color:#748596;font-size:11px;margin-top:4px}.an-ai-icon{height:39px;width:39px;border-radius:12px;color:#fff;background:#087e62;display:grid;place-items:center;font-size:25px}.an-sample{padding:5px 8px;border:1px solid #d3e7de;background:#f1faf5;border-radius:6px;font-weight:800;color:#067c5f;font-size:9px;white-space:nowrap}.an-ask-form{margin-top:14px;display:flex;gap:9px}.an-ask-form input{flex:1;min-width:0;background:#fff;border:1px solid #dbe4ea;padding:0 15px;border-radius:10px;outline:0}.an-prompts{display:flex;flex-wrap:wrap;gap:7px;margin-top:11px}.an-prompt{background:white;color:#64778a;border:1px solid #e3e9ee;border-radius:20px;padding:7px 11px;font-size:10px;font-weight:700}.an-prompt:hover{border-color:#74ba9e;color:#087e62}.an-ai-answer{margin-top:14px;border-top:1px solid #d6e8e0;padding-top:15px}.an-ai-label{display:flex;gap:7px;align-items:center;font-size:11px;font-weight:800;color:#067a5e;margin-bottom:8px}.an-ai-answer>p{font-size:13px;line-height:1.65;color:#243745}.an-ai-answer>small{display:block;margin-top:9px;color:#93a2ac;font-size:10px}.an-mini-bars{max-width:540px;margin-top:12px;display:grid;gap:9px}.an-mini-bars>div{display:grid;grid-template-columns:95px 1fr 85px;align-items:center;gap:10px;font-size:11px;color:#576a7c}.an-mini-bars b{text-align:right;color:#243746}.an-mini-track{height:10px;background:#e4edea;border-radius:10px;overflow:hidden}.an-mini-track i{display:block;height:100%;background:#0c9070;border-radius:10px}.an-toolbar{display:flex;flex-wrap:wrap;align-items:end;gap:11px;padding:13px 15px;margin-bottom:15px}.an-toolbar label,.an-field-grid label,.an-mail-panel label{font-size:10px;font-weight:800;color:#677787;display:grid;gap:6px}.an-toolbar select,.an-toolbar input,.an-field-grid input,.an-field-grid select,.an-mail-panel input,.an-mail-panel select{min-height:40px;border:1px solid var(--line);border-radius:8px;background:#fff;padding:0 11px;font-size:12px;color:#263949;min-width:140px;max-width:100%}.an-toolbar-note{font-size:10px;color:#92a0ae;margin-left:auto;padding-bottom:9px}.an-tabs{margin-top:0;margin-bottom:18px;overflow-x:auto}.an-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-bottom:17px}.an-kpi{padding:20px 18px;display:flex;flex-direction:column;gap:7px;min-height:126px}.an-kpi>span{color:#77879a;font-size:11px;font-weight:700}.an-kpi strong{font:800 26px 'Plus Jakarta Sans',sans-serif;letter-spacing:-.8px;color:#142e2d}.an-kpi small{font-size:10px;color:#99a6b0}.an-two,.an-grid2{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:14px;margin-bottom:15px}.an-grid2{grid-template-columns:repeat(2,minmax(0,1fr))}.an-data-card,.an-chart-card,.an-tender{min-width:0;overflow:hidden}.an-card-head{padding:18px 20px;border-bottom:1px solid #eef1f4;display:flex;justify-content:space-between;align-items:center;gap:12px}.an-card-head h3{font-size:14px}.an-card-head p{color:#92a0ae;font-size:11px;margin-top:5px;line-height:1.5}.an-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.an-table{min-width:100%;white-space:nowrap}.an-table td,.an-table th{font-size:10px;padding:11px 12px}.an-table td b{font-size:11px}.an-table th{color:#93a1ae;font-size:10px;letter-spacing:0}.an-table-foot{padding:11px 17px;border-top:1px solid #eef1f4;color:#8fa0ad;font-size:11px}.an-chart-wrap{height:265px;display:flex;align-items:end;gap:5px;padding:25px 16px 18px;overflow-x:auto}.an-chart-col{flex:1 0 14px;min-width:14px;max-width:46px;height:100%;display:flex;align-items:center;flex-direction:column;gap:9px;justify-content:end}.an-chart-col>span{font-size:9px;color:#93a2af;white-space:nowrap}.an-bar-track{flex:1;width:100%;display:flex;align-items:end;background:repeating-linear-gradient(to top,transparent 0,transparent 24%,#e8edf1 24.5%,transparent 25%);border-bottom:1px solid #e2e8f0}.an-bar{width:100%;min-height:2px;background:linear-gradient(180deg,#27b695,#087e64);border-radius:6px 6px 0 0}.an-tender{display:flex;flex-direction:column}.an-tender-ring{width:154px;height:154px;border-radius:50%;margin:19px auto 10px;background:conic-gradient(#0c8c6c 0 calc(100% - var(--cash)),#efbb6b calc(100% - var(--cash)) 100%);display:grid;place-items:center}.an-tender-ring>div{width:113px;height:113px;background:white;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column}.an-tender-ring strong{font:800 24px 'Plus Jakarta Sans'}.an-tender-ring small{color:#82909b;font-size:10px;margin-top:3px}.an-tender-key{padding:14px 22px;margin-top:auto;display:grid;gap:11px}.an-tender-key>div{display:flex;align-items:center;gap:8px;font-size:12px;color:#758696}.an-tender-key b{margin-left:auto;color:#20333b}.an-key-dot{display:inline-block;height:10px;width:10px;border-radius:4px}.an-key-dot.card{background:#0c8c6c}.an-key-dot.cash{background:#efbb6b}.an-form-panel,.an-template-panel{padding:20px}.an-form-panel>.an-card-head,.an-template-panel>.an-card-head{padding:0 0 16px;margin-bottom:17px}.an-field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.an-field-grid input,.an-field-grid select{width:100%}.an-mail-panel{padding:16px;border:1px solid #e3eae9;background:#fafdfb;border-radius:10px;margin-top:20px;display:grid;gap:11px}.an-mail-panel h4{font-size:12px}.an-mail-panel p{font-size:11px;color:#7e8f9d;line-height:1.6}.an-mail-panel label>input,.an-mail-panel label>select{width:100%}.an-template-row{display:flex;gap:7px;border-bottom:1px solid #eef1f4;padding:13px 0;align-items:center}.an-template-row>div{flex:1;min-width:0;display:grid;gap:4px}.an-template-row b{font-size:12px;overflow-wrap:anywhere}.an-template-row small{font-size:10px;color:#91a0ad;line-height:1.35;overflow-wrap:anywhere}.an-empty{padding:22px;text-align:center;color:#98a6b2;font-size:12px}.an-banner-notice{background:#fff6e7;border:1px solid #ffe2b0;padding:11px;border-radius:9px;line-height:1.55;color:#9d690b;font-size:11px}.an-shift-totals{margin-top:16px;background:#f7faf9;padding:13px 15px;border-radius:10px;display:grid;gap:13px}.an-shift-totals>div,.an-report-line{display:flex;gap:10px;align-items:center;justify-content:space-between;color:#68798b;font-size:12px}.an-shift-totals strong,.an-report-line b{font-size:13px;color:#213a39}.an-negative{color:#bd4255!important}.an-footnote{color:#9daab5;font-size:10px;line-height:1.55;margin-top:13px}.an-batch-amount{font:800 29px 'Plus Jakarta Sans';letter-spacing:-1px;color:#1f3c39;margin:24px 0}.an-batch-amount small{display:block;font:500 11px 'DM Sans';color:#8794a5;margin-top:7px}.an-record-title{font-weight:800;font-size:12px;margin:25px 0 9px}.an-record{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #eef0f3;font-size:11px;color:#84929f}.an-record b{color:#254034}.an-muted{color:#91a1af;font-size:11px;line-height:1.6}.an-overlay{z-index:200;display:flex;align-items:center;justify-content:center}.an-report-sheet{width:min(510px,calc(100vw - 26px));padding:25px;max-height:calc(100vh - 30px);overflow:auto}.an-sheet-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px;gap:9px}.an-sheet-head h2{font-size:22px}.an-sheet-head p{margin-top:7px;color:#8594a5;font-size:11px}.an-report-line{border-bottom:1px dashed #dbe7e4;padding:11px 0}.an-report-sheet>.an-actions{margin-top:18px}.an-owner-workspace{display:grid;grid-template-columns:390px minmax(0,1fr);gap:26px;align-items:start}.an-phone-wrap{display:flex;justify-content:center}.an-phone{border:9px solid #202d34;box-shadow:0 23px 65px #142d3025;background:#f8faf9;width:355px;min-height:700px;border-radius:43px;position:relative;overflow:hidden}.an-phone-notch{position:absolute;top:0;left:50%;transform:translateX(-50%);width:125px;height:22px;background:#202d34;border-radius:0 0 16px 16px;z-index:2}.an-phone-header{background:#0a7a5e;color:white;padding:36px 21px 22px;display:flex;justify-content:space-between;align-items:center}.an-phone-header small{font-size:9px;letter-spacing:1.5px;color:#c3e9df}.an-phone-header h3{font-size:18px;margin-top:5px}.an-phone-avatar{height:38px;width:38px;display:grid;place-items:center;background:#d6f0e6;color:#076e51;border-radius:50%;font-weight:800}.an-phone-body{padding:20px}.an-phone-date{display:flex;justify-content:space-between;color:#738898;font-size:11px}.an-pulse-live{color:#087958;font-weight:800}.an-pulse-live i{display:inline-block;width:6px;height:6px;background:#13ae80;border-radius:50%;margin-right:4px}.an-phone-main{margin-top:16px;padding:20px;border-radius:17px;background:#0d7961;color:white}.an-phone-main small{color:#d3f0e6;font-size:11px}.an-phone-main strong{display:block;font:800 33px 'Plus Jakarta Sans';letter-spacing:-1px;margin:11px 0 6px}.an-phone-main>div{color:#c3e7dc;font-size:10px}.an-phone-smallgrid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:12px 0 19px}.an-phone-smallgrid>div{background:white;border:1px solid #e6eceb;border-radius:12px;padding:12px}.an-phone-smallgrid small{display:block;color:#95a3ad;font-size:10px}.an-phone-smallgrid b{display:block;font-size:17px;margin-top:7px;letter-spacing:-.3px}.an-phone-label{font-size:9px;letter-spacing:1.5px;font-weight:800;color:#95a3ad;display:flex;justify-content:space-between;margin-bottom:9px}.an-phone-label span{letter-spacing:0;color:#0b876a}.an-phone-branch{display:flex;align-items:center;gap:8px;padding:11px 8px;border-bottom:1px solid #e7eceb}.an-phone-branch-icon{background:#e2f3e9;color:#078163;border-radius:10px;height:34px;width:34px;display:grid;place-items:center}.an-phone-branch>div:nth-child(2){flex:1}.an-phone-branch b{font-size:10px}.an-phone-branch small{display:block;font-size:9px;color:#9aaaaf;margin-top:4px}.an-phone-branch>strong{font-size:11px}.an-phone-note{font-size:9px;color:#9aa8b1;line-height:1.5;margin-top:18px}.an-phone-nav{display:flex;justify-content:space-around;padding:16px 5px;border-top:1px solid #e7eceb;background:#fff;color:#9cabb5}.an-phone-nav>span{font-size:18px;display:grid;justify-items:center;gap:2px}.an-phone-nav small{font-size:9px}.an-phone-nav>span:first-child{color:#078b6e}.an-owner-note{padding:27px;margin-bottom:18px}.an-owner-note h2{font-size:23px;line-height:1.4;margin:10px 0}.an-owner-note p{color:#7b8a9a;line-height:1.8;font-size:12px}.an-owner-points{display:grid;gap:14px;margin-top:23px}.an-owner-points>div{display:flex;gap:9px;align-items:center;color:#35645a;font-weight:700;font-size:12px}.an-owner-points svg{color:#0c906f}.an-owner-side{min-width:0}
@media(max-width:1300px){.an-grid2{grid-template-columns:1fr}.an-owner-workspace{grid-template-columns:350px minmax(0,1fr)}.an-data-card{margin-bottom:0}}
@media(max-width:850px){.an-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.an-two{grid-template-columns:1fr}.an-owner-workspace{grid-template-columns:1fr}.an-owner-side{display:grid;grid-template-columns:1fr}.an-toolbar-note{width:100%;margin-left:0}.an-tender-ring{width:135px;height:135px}.an-tender-ring>div{height:100px;width:100px}}
@media(max-width:550px){.an-ask{padding:14px}.an-ask-heading{align-items:flex-start}.an-ask-heading p{line-height:1.5}.an-ask-heading .an-sample{display:none}.an-ask-form{flex-wrap:wrap}.an-ask-form input{min-height:44px;flex-basis:100%}.an-ask-form .btn{flex:1}.an-mini-bars>div{grid-template-columns:80px minmax(0,1fr) 72px}.an-metrics{gap:9px}.an-kpi{padding:13px;min-height:114px}.an-kpi strong{font-size:21px}.an-toolbar label{flex:1 1 140px}.an-toolbar select,.an-toolbar input{width:100%;min-width:0}.an-card-head{flex-wrap:wrap;padding:15px}.an-card-head h3{font-size:13px}.an-field-grid{grid-template-columns:1fr}.an-form-panel,.an-template-panel{padding:15px}.an-chart-wrap{height:202px}.an-phone{width:min(355px,calc(100vw - 45px));border-width:7px;min-height:620px}.an-phone-body{padding:15px}.an-phone-main strong{font-size:27px}.an-owner-note{padding:19px}}
