    // ── PlateOS v5 · analytics, closeouts & owner companion (browser demo) ──
    let anTab='summary',anSpan='7d',anScope='current',anStart='',anEnd='',anGroup='Category',
        anAsk='',anAnswer=null,anTemplateName='',anSelectedTemplate='',anEmail='',anFreq='weekly',
        anShift='Dinner',anClosingDate='',anOpeningFloat='150.00',anCountedCash='',anClosePreview=null,
        anOverlay='',anNotice='';
    const AN_CHANNELS=['POS Register','Server Handheld','Table QR','Self-Order Kiosk','Website','AI Phone Assistant','Uber Eats','DoorDash','Grubhub','Zomato','Swiggy'];
    const anFmt=n=>money((Number(n)||0)/100);
    const anNum=n=>new Intl.NumberFormat('en-US').format(Number(n)||0);
    const anPercent=(a,b)=>b?(a/b*100).toFixed(1)+'%':'—';
    const anBusinessDay=(ms,tz='America/Chicago')=>{
      const parts=new Intl.DateTimeFormat('en-US',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date(ms));
      const field=k=>parts.find(p=>p.type===k)?.value||'00';return `${field('year')}-${field('month')}-${field('day')}`;
    };
    const anHour=(ms,tz='America/Chicago')=>Number(new Intl.DateTimeFormat('en-US',{timeZone:tz,hour:'2-digit',hourCycle:'h23'}).format(new Date(ms)));
    const anClock=ms=>new Date(ms).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'});
    const anToday=()=>anBusinessDay(Date.now(),location().tz);
    function anShiftFor(ms,tz='America/Chicago'){const h=anHour(ms,tz);return h>=5&&h<11?'Breakfast':h>=11&&h<16?'Lunch':h>=16&&h<22?'Dinner':'Late Night'}
    function anDayOffset(back){const [y,m,d]=anToday().split('-').map(Number);return new Date(Date.UTC(y,m-1,d-back,12)).toISOString().slice(0,10)}
    function anZoneTime(day,h,m,tz='America/Chicago'){const [y,mon,d]=day.split('-').map(Number),wanted=Date.UTC(y,mon-1,d,h,m);let ms=wanted;for(let step=0;step<3;step++){const parts=new Intl.DateTimeFormat('en-US',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date(ms)),get=k=>Number(parts.find(p=>p.type===k)?.value||0),actual=Date.UTC(get('year'),get('month')-1,get('day'),get('hour'),get('minute'));ms+=wanted-actual}return ms}
    function anBounds(){const today=anToday();if(anSpan==='custom')return {start:anStart||today,end:anEnd||today};return {start:anDayOffset(anSpan==='today'?0:anSpan==='30d'?29:6),end:today}}
    const anManager=()=>opsManager();
    const anCanAll=()=>opsRole()==='Owner';
    const anAllowedLocation=id=>brand().locations.some(x=>x.id===id)&&(anCanAll()||id===locationId);
    function anInit(){
      db.analyticsDemoSales||=[];db.analyticsDemoVoids||=[];db.analyticsDemoShifts||=[];
      db.analyticsTemplates||=[];db.analyticsClosings||=[];db.analyticsBatchEvents||=[];
      if(!db.analyticsSeededV5){
        for(const b of brands){for(const loc of b.locations){const catalog=opsCatalog(b.id),team=db.employees.filter(e=>e.brandId===b.id&&['Server','Cashier','Manager'].includes(e.role));
          for(let daysAgo=0;daysAgo<24;daysAgo++){
            const businessDay=anDayOffset(daysAgo);
            for(let j=0;j<14;j++){
              const h=[8,9,11,12,12,13,14,17,18,18,19,20,21,22][j],createdAt=anZoneTime(businessDay,h,(j*17+daysAgo*3)%60,loc.tz);
              const chosen=[catalog[(daysAgo+j*3)%catalog.length],catalog[(j*5+daysAgo*2+3)%catalog.length]].filter(Boolean),lines=chosen.map((item,k)=>({itemId:item.id,name:item.name,category:item.cat,qty:k===0?(j%4===0?2:1):1,unitCents:Math.round(item.price*100)}));
              const gross=lines.reduce((s,x)=>s+x.qty*x.unitCents,0),discount=(j%9===0?Math.round(gross*.1):0),net=gross-discount,tax=Math.round(net*TAX),method=(j%3===0?'cash':'card');
              db.analyticsDemoSales.push({id:`demo-${b.id}-${loc.id}-${daysAgo}-${j}`,brandId:b.id,locationId:loc.id,createdAt,day:businessDay,channel:AN_CHANNELS[(j+daysAgo)%AN_CHANNELS.length],orderType:['Dine in','Takeout','Counter','Delivery'][j%4],employeeId:team[j%team.length]?.id||'',method,lines,grossCents:gross,discountCents:discount,netCents:net,taxCents:tax,tipCents:method==='card'?Math.round(net*.11):Math.round(net*.04),isDemo:true});
            }
            if(daysAgo<15){const voidAt=anZoneTime(businessDay,14,20,loc.tz);const employee=team[(daysAgo+1)%team.length];if(employee&&daysAgo%2===0)db.analyticsDemoVoids.push({id:`dv-${b.id}-${loc.id}-${daysAgo}`,brandId:b.id,locationId:loc.id,at:voidAt,employeeId:employee.id,amountCents:550+(daysAgo*107)%1200,reason:'Sample kitchen correction',isDemo:true});
              for(const sh of ['Lunch','Dinner']){const actual= (sh==='Lunch'?9500:16500)+((daysAgo*211+b.id.length*97+loc.id.length*37)%2300),variance=([-225,0,135,0,90,-105,0][daysAgo%7]);
                db.analyticsDemoShifts.push({id:`shift-${b.id}-${loc.id}-${daysAgo}-${sh}`,brandId:b.id,locationId:loc.id,day:businessDay,shift:sh,expectedCents:actual,countedCents:actual+variance,varianceCents:variance,isDemo:true});}
            }
          }
        }}db.analyticsSeededV5=true;save();
      }
      anStart=anDayOffset(6);anEnd=anToday();anClosingDate=anToday();
    }
    function anPaidRows(){const rows=db.payments.filter(p=>p.brandId===brandId&&anAllowedLocation(p.locationId)&&!p.refunded&&p.syncStatus!=='pending_sync').map(p=>{
      const taxIncl=Math.max(0,Number(p.amountCents??p.baseCents??0)),net=Math.round(taxIncl/(1+TAX)),tax=taxIncl-net,
        check=db.checks.find(c=>c.id===p.checkId&&c.brandId===brandId&&c.locationId===p.locationId),
        part=check?.parts?.find(x=>x.id===p.partId),units=part?.kind==='items'?(check?.units||[]).filter(x=>x.sent&&part.unitIds.includes(x.id)):part?[]:(check?.units||[]).filter(x=>x.sent);
      return {id:p.id,brandId,locationId:p.locationId,createdAt:p.createdAt||Date.now(),day:anBusinessDay(p.createdAt||Date.now()),channel:check?'POS Register':'POS demo payment',orderType:check?.service||'Counter',employeeId:p.employeeId||'',method:p.method==='cash'?'cash':'card',lines:units.map(u=>({itemId:u.itemId,name:u.name,category:opsCatalog(brandId).find(i=>i.id===u.itemId)?.cat||'Other',qty:1,unitCents:u.priceCents})),grossCents:Math.round(net+Number(p.discountCents||0)),discountCents:Number(p.discountCents||0),netCents:net,taxCents:tax,tipCents:Number(p.tipCents||0),isDemo:true,isPayment:true};
    });return rows}
    function anRows(noFilter=false){let {start,end}=anBounds();const ids=anScope==='all'&&anCanAll()?new Set(brand().locations.map(l=>l.id)):new Set([locationId]);return [...db.analyticsDemoSales,...anPaidRows()].filter(r=>r.brandId===brandId&&ids.has(r.locationId)&&(noFilter||(r.day>=start&&r.day<=end))).sort((a,b)=>b.createdAt-a.createdAt)}
    function anSummarize(rows){return rows.reduce((a,r)=>{a.gross+=r.grossCents;a.net+=r.netCents;a.tax+=r.taxCents;a.discount+=r.discountCents;a.tips+=r.tipCents;a.cash+=r.method==='cash'?r.netCents+r.taxCents:0;a.card+=r.method==='card'?r.netCents+r.taxCents:0;a.count++;return a},{gross:0,net:0,tax:0,discount:0,tips:0,cash:0,card:0,count:0})}
    function anGroupRows(rows,by='Category'){
      const map=new Map();for(const r of rows){let pieces=[];
        if(by==='Category'||by==='Item'){
          const lines=r.lines?.length?r.lines:[{itemId:'other',name:'Unallocated POS payment',category:'Unallocated',qty:1,unitCents:r.grossCents}];
          const lineGross=lines.reduce((s,l)=>s+l.qty*l.unitCents,0)||1;
          pieces=lines.map((l,i)=>{const weight=l.qty*l.unitCents/lineGross;return {key:by==='Item'?l.name:l.category,qty:l.qty,count:1,net:Math.round(r.netCents*weight),gross:Math.round(r.grossCents*weight),tax:Math.round(r.taxCents*weight),discount:Math.round(r.discountCents*weight),cash:r.method==='cash'?Math.round((r.netCents+r.taxCents)*weight):0,card:r.method==='card'?Math.round((r.netCents+r.taxCents)*weight):0};});
        }else{
          let key=by==='Hour'?`${String(anHour(r.createdAt)).padStart(2,'0')}:00`:by==='Server'?(opsLabelFor(r.employeeId)||'Unassigned'):by==='Payment Type'?r.method==='cash'?'Cash':'Card':by==='Order Type'?r.orderType:by==='Channel'?r.channel:by==='Location'?(brand().locations.find(l=>l.id===r.locationId)?.name||r.locationId):r.day;
          pieces=[{key,qty:r.lines.reduce((s,x)=>s+x.qty,0),count:1,net:r.netCents,gross:r.grossCents,tax:r.taxCents,discount:r.discountCents,cash:r.method==='cash'?r.netCents+r.taxCents:0,card:r.method==='card'?r.netCents+r.taxCents:0}];
        }
        for(const x of pieces){const a=map.get(x.key)||{group:x.key,qty:0,orders:0,net:0,gross:0,tax:0,discount:0,cash:0,card:0};a.qty+=x.qty;a.orders+=x.count;a.net+=x.net;a.gross+=x.gross;a.tax+=x.tax;a.discount+=x.discount;a.cash+=x.cash;a.card+=x.card;map.set(x.key,a)}
      }return [...map.values()].sort((a,b)=>b.net-a.net);
    }
    const anHeadings=['Group','Qty','Orders / Lines','Gross Sales','Discounts','Net Sales','Tax','Cash','Card'];
    const anValues=r=>[r.group,r.qty,r.orders,Number((r.gross/100).toFixed(2)),Number((r.discount/100).toFixed(2)),Number((r.net/100).toFixed(2)),Number((r.tax/100).toFixed(2)),Number((r.cash/100).toFixed(2)),Number((r.card/100).toFixed(2))];
    function anDataset(key){const rows=anRows();if(['Category','Item','Hour','Server','Payment Type','Order Type','Channel','Location','Date'].includes(key))return {name:`Sales by ${key}`,headers:anHeadings,rows:anGroupRows(rows,key).map(anValues)};
      if(key==='Channel Today'){const today=anToday(),dayRows=anRows(true).filter(r=>r.day===today);return {name:'Today by channel',headers:anHeadings,rows:anGroupRows(dayRows,'Channel').map(anValues)}}
      if(key==='PMIX'){const grouped=anGroupRows(rows,'Item'),qty=grouped.reduce((a,r)=>a+r.qty,0);return {name:'Product mix',headers:['Item','Units','Mix %','Gross Sales','Discounts','Net Sales'],rows:grouped.map(r=>[r.group,r.qty,qty?Number((r.qty/qty*100).toFixed(1)):0,r.gross/100,r.discount/100,r.net/100])}}
      if(key==='Voids'){const {start,end}=anBounds(),locs=anScope==='all'&&anCanAll()?brand().locations.map(l=>l.id):[locationId];const demo=db.analyticsDemoVoids.filter(x=>x.brandId===brandId&&locs.includes(x.locationId)&&anBusinessDay(x.at)>=start&&anBusinessDay(x.at)<=end).map(x=>[anClock(x.at),opsLabelFor(x.employeeId),x.amountCents/100,x.reason,'Illustrative']);const real=db.securityEvents.filter(x=>x.brandId===brandId&&locs.includes(x.locationId)&&/void/i.test(x.action)&&anBusinessDay(x.at)>=start&&anBusinessDay(x.at)<=end).map(x=>[anClock(x.at),opsLabelFor(x.initiatedBy),null,x.reason,'Recorded override']);return {name:'Voids',headers:['Timestamp','Employee','Amount ($)','Reason','Source'],rows:[...real,...demo]}}
      if(key==='Shifts'){const {start,end}=anBounds(),locs=anScope==='all'&&anCanAll()?brand().locations.map(l=>l.id):[locationId];const rows=[...db.analyticsDemoShifts,...db.analyticsClosings.filter(c=>c.type==='Z'&&c.countedCents!=null)].filter(x=>x.brandId===brandId&&locs.includes(x.locationId)&&x.day>=start&&x.day<=end);return {name:'Cash variance by shift',headers:['Date','Branch','Shift','Expected cash','Counted cash','Variance','Source'],rows:rows.map(x=>[x.day,brand().locations.find(l=>l.id===x.locationId)?.name||x.locationId,x.shift,x.expectedCents/100,x.countedCents/100,x.varianceCents/100,x.isDemo?'Illustrative':'Demo close'])}}
      if(key==='Taxes'){const sm=anSummarize(rows);return {name:'Taxes & adjustments',headers:['Measure','Amount ($)'],rows:[['Gross sales',sm.gross/100],['Discounts',sm.discount/100],['Net sales',sm.net/100],['Sales tax',sm.tax/100],['Cash tender excl. tips',sm.cash/100],['Card tender excl. tips',sm.card/100],['Tips',sm.tips/100]]}}
      if(key==='Closings')return {name:'Shift closeouts',headers:['Timestamp','Location','Type','Business date','Shift','Net sales','Cash variance','Run by'],rows:db.analyticsClosings.filter(x=>x.brandId===brandId&&anAllowedLocation(x.locationId)).map(x=>[anClock(x.at),brand().locations.find(l=>l.id===x.locationId)?.name||x.locationId,x.type,x.day,x.shift,x.netCents/100,(x.varianceCents??0)/100,opsLabelFor(x.employeeId)])};
      return {name:'Sales',headers:anHeadings,rows:anGroupRows(rows,anGroup).map(anValues)}
    }
    function anTable(title,key,description='',limit=12){const ds=anDataset(key);return `<section class="panel an-data-card"><div class="an-card-head"><div><h3>${safe(title)}</h3><p>${safe(description)}</p></div><div class="an-actions"><button class="btn small" data-action="an-export" data-key="${safe(key)}" data-kind="csv">CSV</button><button class="btn small" data-action="an-export" data-key="${safe(key)}" data-kind="xlsx">.xlsx</button></div></div><div class="table-wrap"><table class="an-table"><thead><tr>${ds.headers.map(h=>`<th>${safe(h)}</th>`).join('')}</tr></thead><tbody>${ds.rows.slice(0,limit).map(row=>`<tr>${row.map((v,i)=>`<td>${i===0?`<b>${safe(v)}</b>`:safe(v==null?'—':typeof v==='number'?(i>=3?money(v):v):v)}</td>`).join('')}</tr>`).join('')||`<tr><td colspan="${ds.headers.length}">No recorded data in this period</td></tr>`}</tbody></table></div>${ds.rows.length>limit?`<div class="an-table-foot">Showing ${limit} of ${ds.rows.length} groups · exports include every row</div>`:''}</section>`}
    function anBarChart(data,title){const arr=data.map(([key,value])=>({key,value:Math.max(0,Number(value)||0)})),max=Math.max(1,...arr.map(x=>x.value));return `<section class="panel an-chart-card"><div class="an-card-head"><div><h3>${safe(title)}</h3><p>Calculated from the selected period's demo transaction ledger</p></div><span class="an-sample">SAMPLE DATA</span></div><div class="an-chart-wrap">${arr.map(p=>`<div class="an-chart-col" title="${safe(p.key)}: ${anFmt(p.value)}"><div class="an-bar-track"><div class="an-bar" style="height:${Math.max(2,Math.round(p.value/max*100))}%"></div></div><span>${safe(p.key)}</span></div>`).join('')}</div></section>`}
    function anAskBar(){return `<section class="an-ask panel"><div class="an-ask-heading"><span class="an-ai-icon">✳</span><div><strong>Ask AI · Revenue intelligence</strong><p>Natural-language analysis computed from this restaurant's demo transactions and security events. No external AI service.</p></div><span class="an-sample">DATA-BOUND DEMO</span></div><form class="an-ask-form" data-an-submit="1" onsubmit="return false"><input id="an-question" aria-label="Ask AI about your restaurant" value="${safe(anAsk)}" placeholder="Ask: How did lunch sales compare to last Tuesday?" autocomplete="off"><button class="btn primary" data-action="an-ask">${ico('spark',16)} Ask AI</button></form><div class="an-prompts">${['How did lunch sales compare to last Tuesday?','Who had the highest voids this week?','Which location had the most sales?','Cash vs card this week'].map(q=>`<button class="an-prompt" data-action="an-prompt" data-question="${safe(q)}">${safe(q)}</button>`).join('')}</div>${anAnswer?`<div class="an-ai-answer"><div class="an-ai-label">${ico('spark',15)} Answer based on demo records</div><p>${safe(anAnswer.text)}</p>${anAnswer.bars?.length?`<div class="an-mini-bars">${anAnswer.bars.map(x=>`<div><span>${safe(x[0])}</span><div class="an-mini-track"><i style="width:${Math.round(x[1]/Math.max(1,...anAnswer.bars.map(y=>y[1]))*100)}%"></i></div><b>${anFmt(x[1])}</b></div>`).join('')}</div>`:''}<small>${safe(anAnswer.note||'Demo fixture values, not connected processor deposits.')}</small></div>`:''}</section>`}
    function anAnswerQuestion(q){const txt=q.toLowerCase();const base=anRows();const summary=anSummarize(base),scope=anScope==='all'&&anCanAll()?'all branches':'selected branch';
      if(/lunch/.test(txt)&&/(tuesday|compare|last)/.test(txt)){
        const [year,month,day]=anToday().split('-').map(Number),dow=new Date(Date.UTC(year,month-1,day)).getUTCDay(),daysBack=(dow-2+7)%7||7,tue=anDayOffset(daysBack),prior=anDayOffset(daysBack+7);
        const data=anRows(true);const val=day=>anSummarize(data.filter(r=>r.day===day&&anShiftFor(r.createdAt)==='Lunch')).net;const a=val(tue),b=val(prior),delta=b?((a-b)/b*100):null;
        return {text:`Lunch net sales on ${tue} were ${anFmt(a)}, compared with ${anFmt(b)} on ${prior}. ${delta==null?'There is no comparable baseline for the earlier Tuesday.':`That is ${Math.abs(delta).toFixed(1)}% ${delta>=0?'higher':'lower'}.`} Scope: ${scope}.`,bars:[['Previous Tue',b],['Last Tue',a]],note:'Lunch is defined as 11:00 AM–3:59 PM in branch local time. Historical numbers are illustrative.'};
      }
      if(/void/.test(txt)){const ds=anDataset('Voids'),list=new Map();for(const r of ds.rows){const k=r[1];list.set(k,(list.get(k)||0)+1)}const ranked=[...list.entries()].sort((a,b)=>b[1]-a[1]);return {text:ranked.length?`${ranked[0][0]} has the most void events in the selected period (${ranked[0][1]}). ${ranked.length>1?`${ranked[1][0]} follows with ${ranked[1][1]}.`:''} Counts include clearly labeled illustrative fixtures.`:'No void approvals were recorded in the selected period.',note:'This query counts logged void actions; fixture voids are included as sample activity.'}}
      if(/location|branch/.test(txt)&&/(most|highest|top|sale|revenue)/.test(txt)){if(!anCanAll())return {text:'Multi-location analysis is available to owners. Managers can analyze their assigned location only.'};const buckets=anGroupRows(anRows(true).filter(r=>{const {start,end}=anBounds();return r.day>=start&&r.day<=end}), 'Location');return {text:buckets.length?`${buckets[0].group} led ${brand().name} with ${anFmt(buckets[0].net)} in net sales during the selected dates.`:'No transactions were found.',bars:buckets.map(x=>[x.group,x.net]).slice(0,5)}}
      if(/cash|card|payment/.test(txt)){return {text:`For ${scope}, net tender receipts excluding tips were ${anFmt(summary.cash)} cash and ${anFmt(summary.card)} card, including sales tax. Card accounts for ${anPercent(summary.card,summary.card+summary.cash)} of tender volume.`,bars:[['Cash',summary.cash],['Card',summary.card]]}}
      if(/top|best|popular|product|sell/.test(txt)){const top=anGroupRows(base,'Item').slice(0,3);return {text:top.length?`Top sellers by net sales: ${top.map(x=>`${x.group} (${anFmt(x.net)}, ${x.qty} units)`).join('; ')}.`:'There are no sold items in this date range.',bars:top.map(x=>[x.group,x.net])}}
      if(/tax/.test(txt)){return {text:`Recorded sales tax is ${anFmt(summary.tax)} on ${anFmt(summary.net)} in net sales for ${scope}. The demo uses a uniform 8.25% example tax; production requires jurisdiction-specific tax logic.`}}
      if(/sale|revenue|today|discount|gross|order/.test(txt)){return {text:`For ${scope} during ${anBounds().start} to ${anBounds().end}, ${summary.count} illustrative settled transactions generated ${anFmt(summary.gross)} gross sales, ${anFmt(summary.discount)} discounts, and ${anFmt(summary.net)} net sales before tax and tips.`,bars:[['Gross',summary.gross],['Net',summary.net]]}}
      return {text:'I can calculate sales trends, lunch versus Tuesday, void leaderboards, product mix, channel performance, taxes, or cash versus card from this restaurant’s demo ledger. Try one of the suggested questions. Free-form AI reasoning is not connected.',note:'No result was invented for this unsupported question.'};
    }
    function anControls(){return `<div class="an-toolbar panel"><label>Period<select id="an-span"><option value="today" ${anSpan==='today'?'selected':''}>Today</option><option value="7d" ${anSpan==='7d'?'selected':''}>Last 7 days</option><option value="30d" ${anSpan==='30d'?'selected':''}>Last 30 days</option><option value="custom" ${anSpan==='custom'?'selected':''}>Custom dates</option></select></label>${anSpan==='custom'?`<label>From<input id="an-start" type="date" value="${safe(anStart)}"></label><label>Through<input id="an-end" type="date" value="${safe(anEnd)}"></label>`:''}<label>Reporting scope<select id="an-scope"><option value="current" ${anScope==='current'?'selected':''}>${safe(location().name)}</option>${anCanAll()?`<option value="all" ${anScope==='all'?'selected':''}>All ${brand().locations.length} branches</option>`:''}</select></label><span class="an-toolbar-note">${safe(anBounds().start)} → ${safe(anBounds().end)} · Demo values</span></div>`}
    function anSummaryView(){const rows=anRows(),s=anSummarize(rows),hrs=Array.from({length:24},(_,i)=>[`${String(i).padStart(2,'0')}h`,rows.filter(r=>anHour(r.createdAt)===i).reduce((a,r)=>a+r.netCents,0)]).filter(([h,v])=>v>0);
      return `<div class="an-metrics">${[['Net sales',anFmt(s.net),'Excludes taxes and tips'],['Gross sales',anFmt(s.gross),'Before discounts'],['Transactions',anNum(s.count),'Paid demo receipts'],['Average ticket',anFmt(s.count?Math.round(s.net/s.count):0),'Average net per receipt']].map(([t,v,d])=>`<div class="panel an-kpi"><span>${t}</span><strong>${v}</strong><small>${d}</small></div>`).join('')}</div><div class="an-two">${anBarChart(hrs,'Net sales by hour')}<div class="panel an-tender"><div class="an-card-head"><div><h3>Payment mix</h3><p>Net tender amount including taxes, excluding tips</p></div></div><div class="an-tender-ring" style="--cash:${(s.cash+s.card)?Math.round(s.cash/(s.cash+s.card)*100):0}%"><div><strong>${anPercent(s.card,s.card+s.cash)}</strong><small>Card</small></div></div><div class="an-tender-key"><div><span class="an-key-dot card"></span>Card <b>${anFmt(s.card)}</b></div><div><span class="an-key-dot cash"></span>Cash <b>${anFmt(s.cash)}</b></div></div></div></div><div class="an-grid2">${anTable('Sales by category','Category','Revenue contribution by food category',9)}${anTable('Sales by channel','Channel','All ordering origins, one ledger',11)}</div><div class="an-grid2">${anTable('Sales by order type','Order Type','Dine-in, pickup, counter and delivery',10)}${anTable('Sales by employee','Server','Revenue attributed to serving employee',10)}</div>`}
    function anPMIXView(){return `<div class="an-grid2">${anTable('Product mix · all items','PMIX','Units, product mix and earned revenue',30)}${anTable('Net sales by hour','Hour','Hourly peaks based on transaction times',24)}</div>`}
    function anExceptionView(){const s=anSummarize(anRows()),voids=anDataset('Voids').rows;return `<div class="an-metrics">${[['Sales tax',anFmt(s.tax),'Uniform example rate'],['Discounts',anFmt(s.discount),'Applied to sample receipts'],['Voids',String(voids.length),'Includes illustrative events'],['Cash tender',anFmt(s.cash),'Excludes tips']].map(([a,b,c])=>`<div class="panel an-kpi"><span>${a}</span><strong>${b}</strong><small>${c}</small></div>`).join('')}</div><div class="an-grid2">${anTable('Taxes and adjustments','Taxes','Amounts from selected date span',20)}${anTable('Voids & approvals','Voids','Illustrative history distinguished from recorded overrides',25)}</div>${anTable('Cash variance per shift','Shifts','Counted cash minus expected drawer amount',35)}`}
    function anReportBuilder(){const templates=db.analyticsTemplates.filter(t=>t.brandId===brandId&&(anCanAll()||t.ownerId===opsActor()?.id));return `<div class="an-grid2 an-builder"><section class="panel an-form-panel"><div class="an-card-head"><div><h3>Custom report builder</h3><p>Group a date-filtered financial ledger and export the full table.</p></div></div><div class="an-field-grid"><label>Group by<select id="an-group">${['Category','Item','Hour','Server','Payment Type','Order Type','Channel','Location','Date'].filter(g=>anCanAll()||g!=='Location').map(g=>`<option ${anGroup===g?'selected':''}>${safe(g)}</option>`).join('')}</select></label><label>Template name<input id="an-template-name" value="${safe(anTemplateName)}" placeholder="e.g. Weekly category summary"></label></div><div class="an-actions" style="margin-top:16px"><button class="btn primary" data-action="an-save-template">${ico('plus',15)} Save template</button><button class="btn" data-action="an-export" data-key="builder" data-kind="xlsx">Export .xlsx</button><button class="btn" data-action="an-export" data-key="builder" data-kind="csv">Export CSV</button></div><div class="an-mail-panel"><h4>Bookkeeper email schedule</h4><p>Save a delivery preference. Automatic sending needs a connected backend scheduler and verified email provider.</p><label>Bookkeeper email<input id="an-email" type="email" value="${safe(anEmail)}" placeholder="bookkeeper@example.com"></label><label>Cadence<select id="an-frequency"><option value="daily" ${anFreq==='daily'?'selected':''}>Daily</option><option value="weekly" ${anFreq==='weekly'?'selected':''}>Weekly</option><option value="monthly" ${anFreq==='monthly'?'selected':''}>Monthly</option></select></label><button class="btn" data-action="an-save-schedule">Save schedule preference</button></div></section><section class="panel an-template-panel"><div class="an-card-head"><div><h3>Saved templates</h3><p>Local presets · isolated by restaurant</p></div></div>${templates.length?templates.map(t=>`<div class="an-template-row"><div><b>${safe(t.name)}</b><small>${safe(t.group)} · ${safe(t.schedule?.frequency||'Manual')} ${t.schedule?.email?`· ${safe(t.schedule.email)}`:''}</small><small>${t.schedule?.email?'Configured only — email not sent':'Run anytime'}</small></div><button class="btn small" data-action="an-load-template" data-id="${safe(t.id)}">Load</button><button class="btn small rose" data-action="an-delete-template" data-id="${safe(t.id)}">Delete</button></div>`).join(''):'<div class="an-empty">No saved templates yet. Create a report preset on the left.</div>'}</section></div>${anTable('Report preview',anGroup,'Changes reflect the chosen date span, branch scope, and grouping.',40)}`}
    function anShiftRows(day,shift){return anRows(true).filter(r=>r.locationId===locationId&&r.day===day&&anShiftFor(r.createdAt)===shift)}
    function anShiftSnapshot(){const rows=anShiftRows(anClosingDate,anShift),sum=anSummarize(rows),opening=Math.round((Number(anOpeningFloat)||0)*100),movement=db.cashEvents.filter(e=>e.brandId===brandId&&e.locationId===locationId&&anBusinessDay(e.at)===anClosingDate&&anShiftFor(e.at)===anShift).reduce((total,x)=>total+(x.type==='Paid-In'?1:-1)*(x.amountCents||0),0),expected=opening+sum.cash+Math.round(rows.filter(r=>r.method==='cash').reduce((a,r)=>a+r.tipCents,0))+movement,counted=anCountedCash===''?null:Math.round(Number(anCountedCash)*100);return {sum,opening,expected,counted,variance:counted==null?null:counted-expected}}
    function anClosingView(){const c=anShiftSnapshot(),prior=db.analyticsClosings.filter(x=>x.brandId===brandId&&x.locationId===locationId).slice().reverse(),batched=db.analyticsBatchEvents.filter(x=>x.brandId===brandId&&x.locationId===locationId).slice().reverse(),already=prior.some(x=>x.type==='Z'&&x.day===anClosingDate&&x.shift===anShift);return `<div class="an-grid2"><section class="panel an-form-panel"><div class="an-card-head"><div><h3>Shift X / Z closeout</h3><p>Read any time (X) or lock a demo closeout snapshot (Z)</p></div><span class="an-sample">SIMULATED</span></div><div class="an-field-grid"><label>Business date<input type="date" id="an-close-date" value="${safe(anClosingDate)}"></label><label>Shift<select id="an-shift">${['Breakfast','Lunch','Dinner','Late Night'].map(x=>`<option ${x===anShift?'selected':''}>${x}</option>`).join('')}</select></label><label>Opening cash float ($)<input type="number" step="0.01" min="0" id="an-float" value="${safe(anOpeningFloat)}"></label><label>Counted cash ($)<input type="number" step="0.01" min="0" id="an-count" value="${safe(anCountedCash)}" placeholder="Enter actual count"></label></div><div class="an-shift-totals"><div><span>Net sales</span><strong>${anFmt(c.sum.net)}</strong></div><div><span>Tax</span><strong>${anFmt(c.sum.tax)}</strong></div><div><span>Card tender</span><strong>${anFmt(c.sum.card)}</strong></div><div><span>Expected cash (float + cash receipts + tips ± movements)</span><strong>${anFmt(c.expected)}</strong></div><div><span>Cash variance</span><strong class="${c.variance!=null&&c.variance<0?'an-negative':''}">${c.variance==null?'Enter counted cash':anFmt(c.variance)}</strong></div></div><div class="an-actions" style="margin-top:15px"><button class="btn" data-action="an-x-report">${ico('receipt',15)} X-report · read only</button><button class="btn primary" data-action="an-z-report" ${already?'disabled':''}>${ico('check',15)} ${already?'Already closed':'Z-report · close shift'}</button></div><p class="an-footnote">Closing records are local snapshots, not certified fiscal Z-reports. Closing does not prevent transactions or settle funds.</p></section><section class="panel an-form-panel"><div class="an-card-head"><div><h3>Credit card batch</h3><p>View tender totals and simulate an end-of-day batch</p></div></div><p class="an-banner-notice">No processor connection. Batch results are demonstration records and cannot deposit funds.</p><div class="an-batch-amount">${anFmt(c.sum.card)} <small>Card tender for selected shift</small></div><button class="btn primary" data-action="an-batch">Simulate card batch settlement</button><div class="an-record-title">Recent simulated batches</div>${batched.slice(0,5).map(x=>`<div class="an-record"><span>${anClock(x.at)} · ${safe(x.shift)}</span><b>${anFmt(x.cardCents)}</b></div>`).join('')||'<p class="an-muted">No batch runs yet</p>'}</section></div><section class="panel an-form-panel"><div class="an-card-head"><div><h3>Closing history</h3><p>Snapshots retained separately for each branch</p></div><button class="btn small" data-action="an-export" data-key="Closings" data-kind="xlsx">Export .xlsx</button></div><div class="table-wrap"><table class="an-table"><thead><tr><th>Closed</th><th>Business date</th><th>Shift</th><th>Net sales</th><th>Cash variance</th><th>Owner / Manager</th></tr></thead><tbody>${prior.map(x=>`<tr><td>${safe(anClock(x.at))}</td><td>${safe(x.day)}</td><td>${safe(x.shift)}</td><td>${anFmt(x.netCents)}</td><td>${x.varianceCents==null?'—':anFmt(x.varianceCents)}</td><td>${safe(opsLabelFor(x.employeeId))}</td></tr>`).join('')||'<tr><td colspan="6">No Z closeouts recorded</td></tr>'}</tbody></table></div></section>`}
    function anCloseDialog(){if(!anClosePreview)return '';const x=anClosePreview,s=x.sum;return `<div class="overlay an-overlay" data-action="an-dismiss-backdrop"><section class="panel an-report-sheet" role="dialog" aria-modal="true" aria-label="${x.type}-report"><div class="an-sheet-head"><div><span class="eyebrow">${x.type==='X'?'MIDSHIFT READ':'END OF DAY CLOSE'}</span><h2>${x.type}-Report · ${safe(location().name)}</h2><p>${safe(anClosingDate)} · ${safe(anShift)} · Sample transaction data</p></div><button class="btn small" data-action="an-close-dialog">Close</button></div><div class="an-report-line"><span>Gross sales</span><b>${anFmt(s.gross)}</b></div><div class="an-report-line"><span>Discounts</span><b>−${anFmt(s.discount)}</b></div><div class="an-report-line"><span>Net sales</span><b>${anFmt(s.net)}</b></div><div class="an-report-line"><span>Sales tax</span><b>${anFmt(s.tax)}</b></div><div class="an-report-line"><span>Card tender</span><b>${anFmt(s.card)}</b></div><div class="an-report-line"><span>Cash tender</span><b>${anFmt(s.cash)}</b></div><div class="an-report-line"><span>Tips</span><b>${anFmt(s.tips)}</b></div><div class="an-report-line"><span>Expected drawer</span><b>${anFmt(x.expected)}</b></div><div class="an-report-line"><span>Counted drawer</span><b>${x.counted==null?'Not entered':anFmt(x.counted)}</b></div><div class="an-report-line"><span>Cash variance</span><b>${x.variance==null?'—':anFmt(x.variance)}</b></div><p class="an-footnote">Demo report. No certified closeout or financial settlement.</p><div class="an-actions">${x.type==='Z'?`<button class="btn primary" data-action="an-confirm-z">Confirm demo close</button>`:'<button class="btn primary" data-action="an-close-dialog">Done</button>'}<button class="btn" data-action="an-export" data-key="Taxes" data-kind="csv">Export figures</button></div></section></div>`}
    function anAnalyticsTabs(){return `<div class="ops-tabs an-tabs">${[['summary','Sales summary'],['mix','PMIX & trends'],['exceptions','Taxes & exceptions'],['closings','X / Z & batch'],['builder','Custom builder']].map(([key,label])=>`<button class="ops-tab ${anTab===key?'active':''}" data-action="an-tab" data-tab="${key}">${label}</button>`).join('')}</div>`}
    function analyticsReports(){if(!opsCan('reports'))return opsDenied();return `${heading('OWNER INTELLIGENCE','Analytics & reporting','A financial command center built from sample tender records, with transparent demo-only closeouts.',`<button class="btn" data-action="mode" data-mode="owner">${ico('devices',16)} Owner mobile</button><button class="btn primary" data-action="an-export" data-key="${safe(anGroup)}" data-kind="xlsx">${ico('arrow',16)} Export Excel</button>`)}${anAskBar()}${anControls()}${anAnalyticsTabs()}${anTab==='summary'?anSummaryView():anTab==='mix'?anPMIXView():anTab==='exceptions'?anExceptionView():anTab==='closings'?anClosingView():anReportBuilder()}${anClosePreview?anCloseDialog():''}`}
    function anOwnerMetrics(){const ids=anCanAll()?brand().locations.map(x=>x.id):[locationId],today=anToday(),rows=[...db.analyticsDemoSales,...anPaidRows()].filter(r=>r.brandId===brandId&&ids.includes(r.locationId)&&r.day===today);return {rows,sum:anSummarize(rows),byLocation:ids.map(id=>{const data=rows.filter(x=>x.locationId===id);return {id,label:brand().locations.find(x=>x.id===id)?.name||id,...anSummarize(data)}})}}
    function anPhone(){const d=anOwnerMetrics(),all=d.sum;return `<div class="an-phone"><div class="an-phone-notch"></div><header class="an-phone-header"><div><small>PLATEOS · OWNER PULSE</small><h3>${safe(brand().name)}</h3></div><span class="an-phone-avatar">${safe((opsActor()?.name||'O').split(' ').map(x=>x[0]).join('').slice(0,2))}</span></header><div class="an-phone-body"><div class="an-phone-date"><span>${new Date().toLocaleDateString('en-US',{timeZone:location().tz,weekday:'long',month:'short',day:'numeric'})}</span><span class="an-pulse-live"><i></i> Demo pulse</span></div><div class="an-phone-main"><small>Net sales today</small><strong>${anFmt(all.net)}</strong><div>Across ${d.byLocation.length} ${d.byLocation.length===1?'location':'locations'} · ${all.count} payments</div></div><div class="an-phone-smallgrid"><div><small>Orders</small><b>${all.count}</b></div><div><small>Avg ticket</small><b>${anFmt(all.count?all.net/all.count:0)}</b></div><div><small>Card sales</small><b>${anFmt(all.card)}</b></div><div><small>Cash sales</small><b>${anFmt(all.cash)}</b></div></div><div class="an-phone-label">LOCATIONS <span>${d.byLocation.length} ACTIVE</span></div>${d.byLocation.map(l=>`<div class="an-phone-branch"><div class="an-phone-branch-icon">${ico('pin',17)}</div><div><b>${safe(l.label)}</b><small>${l.count} paid orders · Today</small></div><strong>${anFmt(l.net)}</strong></div>`).join('')}<div class="an-phone-note">Illustrative payments only. No live processor or push notifications.</div></div><div class="an-phone-nav"><span>▦<small>Pulse</small></span><span>▥<small>Reports</small></span><span>◷<small>Activity</small></span><span>♙<small>Profile</small></span></div></div>`}
    function analyticsOwner(){if(!opsCan('owner'))return opsDenied();const d=anOwnerMetrics();return `${heading('OWNER MOBILE COMPANION','Owner App · live pulse','A responsive phone-width companion preview using the same isolated demo ledger.',`<button class="btn" data-action="mode" data-mode="reports">${ico('chart',16)} Open reports</button>`)}<div class="an-owner-workspace"><div class="an-phone-wrap">${anPhone()}</div><div class="an-owner-side"><div class="panel an-owner-note"><span class="eyebrow">ONE RESTAURANT · EVERY LOCATION</span><h2>Run your business from anywhere.</h2><p>Owners see today's sample performance across their restaurant's branches. Managers are restricted to their selected location; employees without financial permissions cannot open this view.</p><div class="an-owner-points"><div>${ico('check',18)} Single source of truth for net sales, card, and cash</div><div>${ico('check',18)} Branch-by-branch revenue snapshots</div><div>${ico('check',18)} Returns to the full desktop reports in one tap</div></div></div>${anTable('Today’s sales by channel','Channel Today','Current business day · same ledger as phone preview.',8)}</div></div>`}
    function analyticsOverview(){return `${anAskBar()}${overview()}`}
    // Export genuine Office Open XML .xlsx without requiring a CDN or package install.
    function anXml(s){return String(s??'').replace(/[<>&"']/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&apos;'}[c]))}
    function anExcelZip(ds){const rows=[ds.headers,...ds.rows],XML='<?xml version="1.0" encoding="UTF-8" standalone="yes"?>',letter=n=>{let out='';for(let v=n+1;v>0;v=Math.floor((v-1)/26))out=String.fromCharCode(65+(v-1)%26)+out;return out};
      const sheet=`${XML}<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetViews><sheetView workbookViewId="0"/></sheetViews><sheetFormatPr defaultRowHeight="16"/><cols>${ds.headers.map((h,i)=>`<col min="${i+1}" max="${i+1}" width="${Math.min(36,Math.max(14,String(h).length+5))}" customWidth="1"/>`).join('')}</cols><sheetData>${rows.map((row,ri)=>`<row r="${ri+1}">${row.map((value,ci)=>{const ref=letter(ci)+(ri+1);return typeof value==='number'&&Number.isFinite(value)?`<c r="${ref}"${ri===0?' s="1"':''}><v>${value}</v></c>`:`<c r="${ref}" s="${ri===0?1:0}" t="inlineStr"><is><t>${anXml(value==null?'':value)}</t></is></c>`}).join('')}</row>`).join('')}</sheetData></worksheet>`;
      const files={
        '[Content_Types].xml':`${XML}<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/></Types>`,
        '_rels/.rels':`${XML}<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>`,
        'xl/workbook.xml':`${XML}<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets><sheet name="${anXml(ds.name.slice(0,31))}" sheetId="1" r:id="rId1"/></sheets></workbook>`,
        'xl/_rels/workbook.xml.rels':`${XML}<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>`,
        'xl/styles.xml':`${XML}<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><fonts count="2"><font><sz val="11"/><name val="Calibri"/></font><font><b/><sz val="11"/><color rgb="FFFFFFFF"/><name val="Calibri"/></font></fonts><fills count="3"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill><fill><patternFill patternType="solid"><fgColor rgb="FF087F62"/><bgColor indexed="64"/></patternFill></fill></fills><borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders><cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs><cellXfs count="2"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/><xf numFmtId="0" fontId="1" fillId="2" borderId="0" xfId="0" applyFont="1" applyFill="1"/></cellXfs></styleSheet>`,
        'xl/worksheets/sheet1.xml':sheet
      };
      const encoder=new TextEncoder(),parts=[],central=[];let offset=0;const crcTab=new Uint32Array(256);for(let n=0;n<256;n++){let c=n;for(let j=0;j<8;j++)c=(c&1)?0xedb88320^(c>>>1):(c>>>1);crcTab[n]=c>>>0}
      const crc32=arr=>{let c=0xffffffff;for(const byte of arr)c=crcTab[(c^byte)&255]^(c>>>8);return(c^0xffffffff)>>>0};
      const u16=(a,o,n)=>{a[o]=n&255;a[o+1]=(n>>>8)&255},u32=(a,o,n)=>{u16(a,o,n);u16(a,o+2,n>>>16)};
      for(const [name,content] of Object.entries(files)){const nameBytes=encoder.encode(name),body=encoder.encode(content),crc=crc32(body),local=new Uint8Array(30+nameBytes.length);u32(local,0,0x04034b50);u16(local,4,20);u16(local,6,0x0800);u32(local,14,crc);u32(local,18,body.length);u32(local,22,body.length);u16(local,26,nameBytes.length);local.set(nameBytes,30);parts.push(local,body);
        const dir=new Uint8Array(46+nameBytes.length);u32(dir,0,0x02014b50);u16(dir,4,20);u16(dir,6,20);u16(dir,8,0x0800);u32(dir,16,crc);u32(dir,20,body.length);u32(dir,24,body.length);u16(dir,28,nameBytes.length);u32(dir,42,offset);dir.set(nameBytes,46);central.push(dir);offset+=local.length+body.length}
      const centralSize=central.reduce((s,a)=>s+a.length,0),end=new Uint8Array(22);u32(end,0,0x06054b50);u16(end,8,central.length);u16(end,10,central.length);u32(end,12,centralSize);u32(end,16,offset);return new Blob([...parts,...central,end],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
    }
    function anExport(kind,key){const ds=anDataset(key==='builder'?anGroup:key);if(!ds.rows.length)return toast('No rows to export in the selected date range');let blob;
      if(kind==='csv'){const line=r=>r.map(x=>`"${String(x??'').replace(/"/g,'""')}"`).join(',');blob=new Blob(['\uFEFF',line(ds.headers),'\r\n',...ds.rows.map(r=>line(r)+'\r\n')],{type:'text/csv;charset=utf-8'});}else blob=anExcelZip(ds);
      const name=`plateos-${brandId}-${anScope==='all'?'all':locationId}-${ds.name.toLowerCase().replace(/[^a-z0-9]+/g,'-')}-${anToday()}.${kind}`;const a=document.createElement('a'),url=URL.createObjectURL(blob);a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500);toast(`${kind.toUpperCase()} exported · ${ds.rows.length} rows`)}
    function anEventClick(t,e){const a=t.dataset.action;
      if(a==='an-tab'){anTab=t.dataset.tab;anClosePreview=null;render();return true}
      if(a==='an-ask'||a==='an-prompt'){if(a==='an-prompt')anAsk=t.dataset.question;else anAsk=document.querySelector('#an-question')?.value||anAsk;if(!anAsk.trim())return toast('Enter a question'),true;anAnswer=anAnswerQuestion(anAsk.trim());render();return true}
      if(a==='an-export'){anExport(t.dataset.kind,t.dataset.key);return true}
      if(a==='an-save-template'){const name=anTemplateName.trim();if(name.length<3)return toast('Enter a descriptive template name'),true;const template={id:uuid(),brandId,ownerId:opsActor()?.id,name,group:anGroup,scope:anScope,span:anSpan,start:anStart,end:anEnd,schedule:null,createdAt:Date.now()};db.analyticsTemplates.push(template);anSelectedTemplate=template.id;save();toast('Report template saved');return true}
      if(a==='an-load-template'){const tpl=db.analyticsTemplates.find(x=>x.id===t.dataset.id&&x.brandId===brandId);if(tpl){anSelectedTemplate=tpl.id;anTemplateName=tpl.name;anGroup=tpl.group;anSpan=tpl.span;anStart=tpl.start;anEnd=tpl.end;anScope=anCanAll()?tpl.scope:'current';anEmail=tpl.schedule?.email||'';anFreq=tpl.schedule?.frequency||'weekly';render()}return true}
      if(a==='an-delete-template'){const index=db.analyticsTemplates.findIndex(x=>x.id===t.dataset.id&&x.brandId===brandId);if(index>=0){db.analyticsTemplates.splice(index,1);save();toast('Template deleted')}return true}
      if(a==='an-save-schedule'){const tplt=db.analyticsTemplates.find(x=>x.id===anSelectedTemplate&&x.brandId===brandId);if(!tplt)return toast('Save or load a report template first'),true;const email=anEmail.trim();if(!/^\S+@\S+\.\S+$/.test(email))return toast('Enter a valid bookkeeper email'),true;tplt.schedule={email,frequency:anFreq,enabled:true,deliveryStatus:'configuration-only',configuredAt:Date.now()};save();toast('Schedule preference saved · email not sent');return true}
      if(a==='an-x-report'||a==='an-z-report'){if(!anManager())return toast('Owner or manager permission required'),true;const x=anShiftSnapshot();if(a==='an-z-report'&&x.counted==null)return toast('Enter counted cash before Z-close'),true;if(a==='an-z-report'&&db.analyticsClosings.some(r=>r.brandId===brandId&&r.locationId===locationId&&r.day===anClosingDate&&r.shift===anShift&&r.type==='Z'))return toast('Shift already closed'),true;anClosePreview={...x,type:a==='an-x-report'?'X':'Z'};render();return true}
      if(a==='an-confirm-z'){if(!anClosePreview||anClosePreview.type!=='Z')return true;const s=anClosePreview.sum,record={id:uuid(),brandId,locationId,type:'Z',day:anClosingDate,shift:anShift,at:Date.now(),employeeId:opsActor().id,grossCents:s.gross,discountCents:s.discount,netCents:s.net,taxCents:s.tax,cardCents:s.card,cashCents:s.cash,openingCents:anClosePreview.opening,expectedCents:anClosePreview.expected,countedCents:anClosePreview.counted,varianceCents:anClosePreview.variance,simulation:true};if(!db.analyticsClosings.some(x=>x.brandId===brandId&&x.locationId===locationId&&x.day===anClosingDate&&x.shift===anShift&&x.type==='Z'))db.analyticsClosings.push(record);anClosePreview=null;save();toast('Demo Z-report recorded; no fiscal close performed');return true}
      if(a==='an-close-dialog'){anClosePreview=null;render();return true}
      if(a==='an-dismiss-backdrop'){if(t===e.target){anClosePreview=null;render()}return true}
      if(a==='an-batch'){if(!anManager())return true;const snapshot=anShiftSnapshot(),exists=db.analyticsBatchEvents.some(x=>x.brandId===brandId&&x.locationId===locationId&&x.day===anClosingDate&&x.shift===anShift);if(exists)return toast('A demo batch is already recorded for this shift'),true;db.analyticsBatchEvents.push({id:uuid(),brandId,locationId,day:anClosingDate,shift:anShift,at:Date.now(),employeeId:opsActor()?.id,cardCents:snapshot.sum.card,simulation:true});save();toast('Simulated batch recorded · no card network request');return true}
      return false;
    }
    function anChange(e){const t=e.target;const fields={'an-span':'anSpan','an-scope':'anScope','an-group':'anGroup','an-frequency':'anFreq','an-shift':'anShift','an-close-date':'anClosingDate'};
      if(fields[t.id]){const v=t.value;switch(t.id){case 'an-span':anSpan=v;break;case 'an-scope':anScope=anCanAll()?v:'current';break;case 'an-group':anGroup=v;break;case 'an-frequency':anFreq=v;break;case 'an-shift':anShift=v;break;case 'an-close-date':anClosingDate=v;break;}anAnswer=null;render();return true}
      if(t.id==='an-start'){anStart=t.value;render();return true}if(t.id==='an-end'){anEnd=t.value;render();return true}return false;
    }
    function anInput(e){const t=e.target;switch(t.id){case 'an-question':anAsk=t.value;return true;case 'an-template-name':anTemplateName=t.value;return true;case 'an-email':anEmail=t.value;return true;case 'an-float':anOpeningFloat=t.value;return true;case 'an-count':anCountedCash=t.value;return true;}return false}
    anInit();
